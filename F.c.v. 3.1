updateQualyCountdown = function()
    if not qualyActive then
        qualyCountdownLabel.Text       = "Detenida"
        qualyCountdownLabel.TextColor3 = Color3.fromRGB(200,200,200)
        return
    end
    local remaining = math.max(0, math.floor((qualyEndTime or 0) - tick()))
    if remaining <= 0 then
        qualyActive = false
        qualyCountdownLabel.Text       = "Finalizada"
        qualyCountdownLabel.TextColor3 = Color3.fromRGB(255,120,120)
        logEvent("QUALY: sesion finalizada")
        sendDiscordEvent(":checkered_flag: **QUALY** - La sesion ha finalizado")
        return
    end
    local m = math.floor(remaining / 60)
    local s = remaining % 60
    qualyCountdownLabel.Text       = string.format("%d:%02d", m, s)
    qualyCountdownLabel.TextColor3 = Color3.fromRGB(255,220,50)
end

