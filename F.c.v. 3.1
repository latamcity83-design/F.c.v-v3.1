-- Cache del efecto de fuego/particulas del escape encontrado para cada
-- jugador, para no tener que recorrer todo el modelo del auto cada frame.
local playerBoostEffectCache = {} -- [userId] = { model = Model, effect = Instance }

-- Busca dentro del modelo un Fire o ParticleEmitter que represente el
-- fuego/chispas del escape al usar el boost (efecto visual que SI se
-- replica a todos los clientes, a diferencia de un value interno que
-- podria ser solo del servidor/cliente que lo usa).
-- Patron confirmado en Brookhaven: una parte/instancia llamada
-- "NitrousPoint" que contiene un ParticleEmitter llamado "fire".
local function findExhaustBoostEffect(model)
    if not model then return nil end

    -- 1) Coincidencia exacta confirmada: NitrousPoint > fire
    local nitrousPoint = model:FindFirstChild("NitrousPoint", true)
    if nitrousPoint then
        local fireEmitter = nitrousPoint:FindFirstChild("fire")
            or nitrousPoint:FindFirstChildOfClass("ParticleEmitter")
            or nitrousPoint:FindFirstChildOfClass("Fire")
        if fireEmitter and (fireEmitter:IsA("ParticleEmitter") or fireEmitter:IsA("Fire")) then
            return fireEmitter
        end
    end

    -- 2) Respaldo generico por nombre, para otros autos/versiones
    local bestGeneric = nil
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("Fire") or desc:IsA("ParticleEmitter") then
            local n = desc.Name:lower()
            if n:find("boost") or n:find("nitro") or n:find("nos") then
                return desc
            end
            if (n:find("fire") or n:find("flame") or n:find("exhaust") or n:find("backfire"))
               and not bestGeneric then
                bestGeneric = desc
            end
        end
    end
    return bestGeneric
end

local function getPlayerBoostEffect(player, model)
    local uid = player.UserId
    local cached = playerBoostEffectCache[uid]
    if cached and cached.model == model and cached.effect and cached.effect.Parent then
        return cached.effect
    end
    local effect = findExhaustBoostEffect(model)
    playerBoostEffectCache[uid] = { model = model, effect = effect }
    return effect
end

-- Busca un indicador de boost/nitro activo dentro del asiento o del
-- modelo del auto de Brookhaven. Prioriza el patron confirmado
-- (NitrousPoint.fire, un ParticleEmitter que se activa/desactiva con
-- el boost); como respaldo revisa nombres de value comunes y busquedas
-- genericas, por si el nombre exacto varia entre autos/actualizaciones.
local function isBrookhavenBoostActive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not isInVehicleSeat(hum) then return false end
    local seat = hum.SeatPart

    -- Subir hasta el modelo MAS ALTO (los autos de Brookhaven pueden
    -- tener sub-modelos anidados; el efecto de nitro puede estar en
    -- una rama distinta a la del asiento).
    local current = seat
    local model = nil
    while current and current ~= workspace do
        if current:IsA("Model") then model = current end
        current = current.Parent
    end

    -- 1) Patron confirmado: NitrousPoint.fire (ParticleEmitter.Enabled)
    if model then
        local effect = getPlayerBoostEffect(player, model)
        if effect then
            local ok, enabled = pcall(function() return effect.Enabled end)
            if ok and enabled then return true end
        end
    end

    -- 2) Respaldo: values con nombres comunes de boost/nitro
    local possibleNames = {
        "Boost", "Boosting", "IsBoosting", "BoostActive", "UsingBoost",
        "Nitro", "NitroActive", "NOS", "NosActive", "BoostEnabled"
    }

    local function checkContainer(container)
        if not container then return nil end
        for _, nm in ipairs(possibleNames) do
            local v = container:FindFirstChild(nm)
            if v then
                if v:IsA("BoolValue") then
                    return v.Value
                elseif v:IsA("NumberValue") or v:IsA("IntValue") then
                    return v.Value ~= 0
                end
            end
        end
        return nil
    end

    local result = checkContainer(seat)
    if result ~= nil then return result end

    if model then
        result = checkContainer(model)
        if result ~= nil then return result end

        for _, nm in ipairs(possibleNames) do
            local ok, attr = pcall(function() return model:GetAttribute(nm) end)
            if ok and attr ~= nil then
                if typeof(attr) == "boolean" then return attr end
                if typeof(attr) == "number" then return attr ~= 0 end
            end
        end

        for _, desc in ipairs(model:GetDescendants()) do
            local n = desc.Name:lower()
            if (n:find("boost") or n:find("nitro") or n:find("nos")) then
                if desc:IsA("BoolValue") then
                    return desc.Value
                elseif desc:IsA("NumberValue") or desc:IsA("IntValue") then
                    return desc.Value ~= 0
                end
            end
        end
    end

    return false
end

RunService.Heartbeat:Connect(function()
    if replayPlaying then return end
    for _, plr in ipairs(getAllPlayers()) do
        local char = plr.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local uid = plr.UserId
            if isInVehicleSeat(hum) then
                local spd = getBrookhavenVehicleSpeed(plr)
                updatePlayerSpeed(uid, spd)

                -- Registrar velocidad maxima
                if not maxVehicleSpeeds[uid] or spd > maxVehicleSpeeds[uid] then
                    maxVehicleSpeeds[uid] = spd
                end

                -- Alerta de exceso de velocidad
                if spd > speedLimit then
                    local lastAlert = speedAlertCooldown[uid] or 0
                    if tick() - lastAlert > 5 then
                        speedAlertCooldown[uid] = tick()
                        showSpeedAlert(plr.Name, spd)
                        sendDiscordEvent(":warning: **EXCESO DE VELOCIDAD** - **" .. plr.Name .. "** va a **" .. formatSpeed(spd) .. "** (limite: " .. formatSpeed(speedLimit) .. ")")
                        logEvent("EXCESO: " .. plr.Name .. " a " .. formatSpeed(spd))
                    end
                end

                -- Deteccion de boost (flanco de subida: inactivo -> activo)
                local boostActive = isBrookhavenBoostActive(plr)
                local prevBoostState = playerBoostState[uid] or "idle"
                if boostActive and prevBoostState == "idle" then
                    playerBoostState[uid]  = "active"
                    playerBoostCount[uid]  = (playerBoostCount[uid] or 0) + 1
                    updateBoostPanel()
                    logEvent("BOOST: " .. plr.Name .. " (" .. playerBoostCount[uid] .. ")")
                elseif not boostActive and prevBoostState == "active" then
                    playerBoostState[uid] = "idle"
                end

                prevSpeeds[uid] = spd
            else
                updatePlayerSpeed(uid, 0)
                prevSpeeds[uid] = 0
            end
        end
    end
end)

