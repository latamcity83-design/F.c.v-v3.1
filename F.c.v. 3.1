local F1M_loader = loadstring or load
if not F1M_loader then
    F1M_ShowError("Tu ejecutor no tiene loadstring")
else
    local F1M_fn, F1M_cerr = F1M_loader(F1M_SOURCE, "F1M")
    if not F1M_fn then
        F1M_ShowError("Error de compilacion: " .. tostring(F1M_cerr))
    else
        local F1M_ok, F1M_err = pcall(F1M_fn)
        if not F1M_ok then F1M_ShowError("Error al iniciar: " .. tostring(F1M_err)) end
    end
