-- F1M Race System / F.C.V (cargador con diagnostico de errores)
local function F1M_ShowError(msg)
    msg = tostring(msg)
    pcall(function() warn("[F1M] ERROR: " .. msg) end)
    pcall(function()
        local Players = game:GetService("Players")
        local parent
        pcall(function() parent = (gethui and gethui()) or nil end)
        if not parent then
            local lp = Players.LocalPlayer
            while not lp do task.wait(0.1); lp = Players.LocalPlayer end
            parent = lp:WaitForChild("PlayerGui", 10)
        end
        local gui = Instance.new("ScreenGui")
        gui.Name = "F1MLoaderError"
        gui.ResetOnSpawn = false
        gui.Parent = parent
        local box = Instance.new("TextLabel")
        box.Size = UDim2.new(0.9, 0, 0, 160)
        box.Position = UDim2.new(0.05, 0, 0.05, 0)
        box.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.TextWrapped = true
        box.TextSize = 14
        box.Font = Enum.Font.Code
        box.Text = "F1M NO PUDO CARGAR:\n" .. msg
        box.Parent = gui
    end)
end

