playReplay = function(entry)
    if replayPlaying then return end
    if not entry.ghostA then return end
    if #entry.framesA == 0 then return end
    local hasB = entry.ghostB ~= nil and #entry.framesB > 0
    replayPlaying = true

    Dashboard.Visible = false
    F1MButton.Visible = false
    CCButton.Visible  = false
    ReplayExitBtn.Visible = true
    ReplayLabel.Visible   = true
    ReplayLabel.Text      = entry.text

    local ghostA = entry.ghostA:Clone()
    local ghostB = hasB and entry.ghostB:Clone() or nil
    for _, desc in ipairs(ghostA:GetDescendants()) do
        if desc:IsA("BasePart") then desc.Transparency = math.clamp(desc.Transparency + 0.35, 0, 0.9) end
    end
    if ghostB then
        for _, desc in ipairs(ghostB:GetDescendants()) do
            if desc:IsA("BasePart") then desc.Transparency = math.clamp(desc.Transparency + 0.35, 0, 0.9) end
        end
        ghostB.Parent = workspace
    end
    ghostA.Parent = workspace

    Camera.CameraType = Enum.CameraType.Scriptable

    local framesA, framesB = entry.framesA, entry.framesB
    local totalFrames = hasB and math.max(#framesA, #framesB) or #framesA
    local lastDir = nil

    local stopRequested = false
    local exitConn
    exitConn = ReplayExitBtn.MouseButton1Click:Connect(function()
        stopRequested = true
    end)

    for i = 1, totalFrames do
        if stopRequested then break end
        local fA = framesA[math.min(i, #framesA)]
        pcall(function() ghostA:PivotTo(fA.cf) end)
        if hasB then
            local fB = framesB[math.min(i, #framesB)]
            pcall(function() ghostB:PivotTo(fB.cf) end)

            -- Camara: por detras y arriba del punto medio entre los dos autos
            local midPoint = fA.cf.Position:Lerp(fB.cf.Position, 0.5)
            local back = (fA.cf.Position - fB.cf.Position)
            if back.Magnitude < 1 then back = Vector3.new(0,0,10) end
            back = back.Unit
            local camPos = midPoint + Vector3.new(0, 14, 0) + back * 22
            Camera.CFrame = CFrame.new(camPos, midPoint)
        else
            -- Un solo auto: camara detras (segun su direccion de avance) y arriba
            local pos = fA.cf.Position
            if i > 1 then
                local d = pos - framesA[i-1].cf.Position
                d = Vector3.new(d.X, 0, d.Z)
                if d.Magnitude > 0.5 then lastDir = d.Unit end
            end
            local dir = lastDir or Vector3.new(0,0,-1)
            Camera.CFrame = CFrame.new(pos - dir * 20 + Vector3.new(0, 9, 0), pos)
        end

        task.wait(0.1) -- reproduccion en camara lenta (~0.5x)
    end

    exitConn:Disconnect()
    ghostA:Destroy()
    if ghostB then ghostB:Destroy() end

    Camera.CameraType = Enum.CameraType.Custom
    F1MButton.Visible = true
    CCButton.Visible  = true
    ReplayExitBtn.Visible = false
    ReplayLabel.Visible   = false
    replayPlaying = false
end

-- Este sistema no necesita correr a 60 cuadros por segundo: 10 veces
-- por segundo alcanza de sobra para detectar choques y grabar un
-- historial fluido, y baja bastante el costo (menos escaneos de
-- jugadores, menos crecimiento del historial por grabar).
local COLLISION_TICK_INTERVAL = 0.1
local collisionAccum = 0

RunService.Heartbeat:Connect(function(dt)
    if replayPlaying then return end -- no hace falta seguir detectando mientras se ve una repeticion

    collisionAccum = collisionAccum + dt
    if collisionAccum < COLLISION_TICK_INTERVAL then return end
    collisionAccum = 0

    local list = getAllPlayers()

    -- PASO 1: recolectar datos de cada auto ocupado este frame, y
    -- guardar su posicion en el historial (pre-roll para repeticiones)
    local snapshot = {} -- [uid] = { model=, ref=, vel=, radius= }
    for _, plr in ipairs(list) do
        local model = getPlayerVehicleModel(plr)
        if model then
            local ref = getVehicleReferencePart(model)
            if ref then
                local vel = ref.AssemblyLinearVelocity.Magnitude
                snapshot[plr.UserId] = {
                    model  = model,
                    ref    = ref,
                    vel    = vel,
                    radius = getVehicleRadius(model),
                }
                pushHistory(plr.UserId, ref.CFrame)
            end
        end
    end

    -- PASO 2: comparar cada par usando la velocidad del frame ANTERIOR
    -- (guardada en crashPrevVel, que este mismo sistema controla, para
    -- no depender de otras rutinas que ya sobreescriben prevSpeeds).
    for i = 1, #list do
        local plrA = list[i]
        local dataA = snapshot[plrA.UserId]
        if dataA then
            local prevVelA = crashPrevVel[plrA.UserId] or dataA.vel
            local dropA = prevVelA > 12 and dataA.vel < (prevVelA * 0.55)

            for j = i + 1, #list do
                local plrB = list[j]
                local dataB = snapshot[plrB.UserId]
                if dataB then
                    local prevVelB = crashPrevVel[plrB.UserId] or dataB.vel
                    local dropB = prevVelB > 12 and dataB.vel < (prevVelB * 0.55)

                    local dist = (dataA.ref.Position - dataB.ref.Position).Magnitude
                    local threshold = dataA.radius + dataB.radius + 1.5

                    local pairKey = math.min(plrA.UserId, plrB.UserId) .. "_" .. math.max(plrA.UserId, plrB.UserId)
                    local isColliding = dist <= threshold and (dropA or dropB)

                    if isColliding and not collisionState[pairKey] then
                        collisionState[pairKey] = true
                        local outcomeA = classifyOutcome(dataA.model, dataA.ref)
                        local outcomeB = classifyOutcome(dataB.model, dataB.ref)
                        local text = "El piloto " .. plrA.Name .. " ha colisionado con " .. plrB.Name
                            .. " y " .. plrA.Name .. " ha terminado " .. outcomeA
                            .. ", " .. plrB.Name .. " ha terminado " .. outcomeB
                        startReplayCapture(plrA, dataA, plrB, dataB, text)
                        logEvent("CHOQUE: " .. plrA.Name .. " vs " .. plrB.Name)
                        sendDiscordEvent(":boom: **CHOQUE** - **" .. plrA.Name .. "** colisiono con **" .. plrB.Name .. "**")

                        -- SANCIONES: determinar culpable y penalizar segun
                        -- que tan fuerte fue el choque (heuristica, ver
                        -- determineFault mas arriba)
                        local faultSide, faultMargin = determineFault(dataA, dataB)
                        if faultSide then
                            local dropMagnitude = math.max(prevVelA - dataA.vel, prevVelB - dataB.vel)
                            local seconds = penaltySecondsFor(dropMagnitude)
                            if faultSide == "A" then
                                applyPenalty(plrA, seconds, "se ha reincorporado de manera peligrosa y ha chocado a " .. plrB.Name)
                            else
                                applyPenalty(plrB, seconds, "se ha reincorporado de manera peligrosa y ha chocado a " .. plrA.Name)
                            end
                        end
                    elseif dist > threshold * 1.8 then
                        collisionState[pairKey] = false
                    end
                end
            end
        end
    end

    -- PASO 3: guardar la velocidad de este frame para la proxima comparacion
    for uid, data in pairs(snapshot) do
        crashPrevVel[uid] = data.vel
    end
end)
end)() -- fin del IIFE del sistema de choques/repeticiones/sanciones

