local function updateF1Bar()
    for _, c in ipairs(f1Scroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    f1Rows = {}

    local sorted = getOrderedPlayers()

    local leaderLaps = #sorted > 0 and (playerLaps[sorted[1].UserId] or 0) or 0
    f1LapInfo.Text = totalLaps > 0
        and string.format("VUELTA LIDER: %d / %d", leaderLaps, totalLaps)
        or  string.format("VUELTA LIDER: %d", leaderLaps)

    for pos, plr in ipairs(sorted) do
        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1,-4,0,40)
        row.BackgroundColor3 = pos==1 and Color3.fromRGB(30,30,50) or Color3.fromRGB(16,16,26)
        row.BorderSizePixel  = 0
        row.LayoutOrder      = pos
        row.ClipsDescendants = true
        row.ZIndex           = 17
        row.Parent           = f1Scroll
        Instance.new("UICorner", row).CornerRadius = UDim.new(0,4)

        local posL = Instance.new("TextLabel")
        posL.Size            = UDim2.new(0,22,0,20)
        posL.BackgroundColor3 = pos==1 and Color3.fromRGB(200,20,20) or Color3.fromRGB(35,35,55)
        posL.Text            = tostring(pos)
        posL.TextColor3      = Color3.fromRGB(255,255,255)
        posL.Font            = Enum.Font.GothamBold
        posL.TextSize        = 12
        posL.BorderSizePixel = 0
        posL.ZIndex          = 18
        posL.Parent          = row
        Instance.new("UICorner", posL).CornerRadius = UDim.new(0,4)

        local nameL = Instance.new("TextLabel")
        nameL.Size           = UDim2.new(1,-82,0,20)
        nameL.Position       = UDim2.new(0,26,0,0)
        nameL.BackgroundTransparency = 1
        nameL.Text           = plr.Name
        nameL.TextColor3     = Color3.fromRGB(230,230,230)
        nameL.Font           = Enum.Font.GothamSemibold
        nameL.TextSize       = 11
        nameL.TextXAlignment = Enum.TextXAlignment.Left
        nameL.ClipsDescendants = true
        nameL.ZIndex         = 18
        nameL.Parent         = row

        local statusBox = Instance.new("Frame")
        statusBox.Size       = UDim2.new(0,50,0,20)
        statusBox.Position   = UDim2.new(1,-54,0,0)
        local laps   = playerLaps[plr.UserId] or 0
        local status = playerStatus[plr.UserId] or "outlap"
        statusBox.BackgroundColor3 = (status=="outlap" or laps==0)
            and Color3.fromRGB(70,70,80) or Color3.fromRGB(30,110,50)
        statusBox.BorderSizePixel  = 0
        statusBox.ZIndex   = 18
        statusBox.Parent   = row
        Instance.new("UICorner", statusBox).CornerRadius = UDim.new(0,4)

        local statusL = Instance.new("TextLabel")
        statusL.Size     = UDim2.new(1,0,1,0)
        statusL.BackgroundTransparency = 1
        if status=="outlap" or laps==0 then
            statusL.Text       = "Out lap"
            statusL.TextColor3 = Color3.fromRGB(160,160,170)
        else
            statusL.Text       = "Lap "..tostring(laps)
            statusL.TextColor3 = Color3.fromRGB(200,255,200)
        end
        statusL.Font     = Enum.Font.GothamBold
        statusL.TextSize = 9
        statusL.ZIndex   = 19
        statusL.Parent   = statusBox

        -- GAP (estilo F1): "GAP" para el que marca la referencia,
        -- cronometro corriendo mientras alcanza al lider, y el
        -- tiempo congelado una vez que cruza la meta.
        local gapText, gapColor = formatGap(metaGapTracker, plr.UserId)
        local gapL = Instance.new("TextLabel")
        gapL.Size             = UDim2.new(1,-30,0,16)
        gapL.Position         = UDim2.new(0,26,0,22)
        gapL.BackgroundTransparency = 1
        gapL.Text             = gapText
        gapL.TextColor3       = gapColor
        gapL.Font             = Enum.Font.Code
        gapL.TextSize         = 12
        gapL.TextXAlignment   = Enum.TextXAlignment.Left
        gapL.ZIndex           = 18
        gapL.Parent           = row

        f1Rows[plr.UserId] = row
    end
    f1Scroll.CanvasSize = UDim2.new(0,0,0, f1ListLayout.AbsoluteContentSize.Y + 6)
end

