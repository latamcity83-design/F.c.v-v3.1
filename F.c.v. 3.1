            if list[spectatingIndex] then
                hudName.Text = list[spectatingIndex].Name
            end
        end
    end
end)

-- ============================================================
-- INICIALIZAR JUGADORES
-- ============================================================
for _, plr in ipairs(getAllPlayers()) do
    playerLaps[plr.UserId]          = 0
    playerStatus[plr.UserId]        = "outlap"
    playerVehicleSpeeds[plr.UserId] = 0
    playerFLState[plr.UserId]       = "outside"
end

Players.PlayerAdded:Connect(function(plr)
    playerLaps[plr.UserId]          = 0
    playerStatus[plr.UserId]        = "outlap"
    playerVehicleSpeeds[plr.UserId] = 0
    playerFLState[plr.UserId]       = "outside"
    if F1Bar.Visible then updateF1Bar() end
end)

Players.PlayerRemoving:Connect(function(plr)
    local uid = plr.UserId
    playerLaps[uid]          = nil
    playerLapTimestamp[uid]  = nil
    playerStatus[uid]        = nil
    playerVehicleSpeeds[uid] = nil
    playerFLState[uid]       = nil
    playerInTiming[uid]      = nil
    if velRows[uid] then
        velRows[uid]:Destroy()
        velRows[uid] = nil
    end
    if F1Bar.Visible then updateF1Bar() end
    if onboardActive then
        local list = getAllPlayers()
        if #list > 0 then
            startOnboard(spectatingIndex)
        else
            stopOnboard()
        end
    end
end)

switchTab("Objetos")
print("[F1M] Sistema v3 cargado correctamente.")

end -- fin de buildF1MSystem()

