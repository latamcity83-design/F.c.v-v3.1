    btn.BorderSizePixel  = 0
    btn.LayoutOrder      = order
    btn.ZIndex           = 22
    btn.Parent           = TabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    local tabSt = Instance.new("UIStroke")
    tabSt.Color     = Color3.fromRGB(55,55,70)
    tabSt.Thickness = 1
    tabSt.Parent    = btn

    local panel = Instance.new("Frame")
    panel.Size               = UDim2.new(1,0,1,0)
    panel.BackgroundTransparency = 1
    panel.Visible            = false
    panel.ZIndex             = 22
    panel.Parent             = ContentFrame

    tabPanels[name] = { btn = btn, panel = panel }
    return btn, panel
end

local function switchTab(name)
    for tname, t in pairs(tabPanels) do
        t.panel.Visible = (tname == name)
        if tname == name then
            t.btn.BackgroundColor3 = Color3.fromRGB(200,20,20)
            t.btn.TextColor3       = Color3.fromRGB(255,255,255)
        else
            t.btn.BackgroundColor3 = Color3.fromRGB(28,28,36)
            t.btn.TextColor3       = Color3.fromRGB(200,200,200)
        end
    end
    activeTab = name
end

