local function formatTime(seconds)
    if not seconds then return "--:--.---" end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    local ms   = math.floor((seconds % 1) * 1000)
    return string.format("%d:%02d.%03d", mins, secs, ms)
end

local function formatSpeed(v)
    if v == 0 then return "0 km" end
    -- string.format("%.1f") usa el redondeo correcto del sistema,
    -- sin errores de punto flotante como los de math.floor(v*10+0.5)/10
    local s = string.format("%.1f", v)
    -- Quitar el ".0" si el valor es entero (ej. "50.0" -> "50 km")
    if s:sub(-2) == ".0" then
        return s:sub(1, -3) .. " km"
    end
    return s .. " km"
end

