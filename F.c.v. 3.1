    assignView.Visible = (which == "assign")
end

local function tireLaps(uid)
    local t = playerTires[uid]
    if not t then return 0 end
    local laps = playerLaps[uid] or 0
    if laps < t.base then t.base = laps end -- se reinicio el conteo de vueltas
    return laps - t.base
end

local function clearRows(sf)
    for _, c in ipairs(sf:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

local function buildMain()
    clearRows(mainScroll)
    for i, plr in ipairs(getAllPlayers()) do
        local row = newRow(mainScroll, i)
        newLabel(row, plr.Name, UDim2.new(0.45,-10,1,0), UDim2.new(0,10,0,0),
            Color3.fromRGB(255,255,255), Enum.Font.GothamBold, 13, 25)
        local t = playerTires[plr.UserId]
        if t then
            local info = TIRES[t.compound]
            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0,22,0,22)
            dot.Position = UDim2.new(0.45,0,0.5,-11)
            dot.BackgroundColor3 = info.color
            dot.BorderSizePixel = 0
            dot.ZIndex = 25
            dot.Parent = row
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0)
            local st = Instance.new("UIStroke")
            st.Color = Color3.fromRGB(90,90,100)
            st.Thickness = 2
            st.Parent = dot
            local n = tireLaps(plr.UserId)
            local limit = tireLife[t.compound] or 0
            local txt, col
            if limit > 0 then
                txt = info.name .. "  ·  " .. n .. "/" .. limit .. " vueltas"
                col = (n >= limit) and Color3.fromRGB(255,90,90) or Color3.fromRGB(230,230,230)
                if n >= limit then txt = txt .. "  DESGASTADOS" end
            else
                txt = info.name .. "  ·  " .. n .. (n == 1 and " vuelta" or " vueltas")
                col = Color3.fromRGB(230,230,230)
            end
            newLabel(row, txt, UDim2.new(0.55,-40,1,0), UDim2.new(0.45,30,0,0),
                col, Enum.Font.GothamSemibold, 12, 25)
        else
            newLabel(row, "Neumáticos sin asignar", UDim2.new(0.55,-10,1,0), UDim2.new(0.45,0,0,0),
                Color3.fromRGB(150,150,160), Enum.Font.Gotham, 12, 25)
        end
    end
    mainScroll.CanvasSize = UDim2.new(0,0,0, mainLayout.AbsoluteContentSize.Y + 10)
end

local function buildAssign()
    clearRows(assignScroll)
    for i, plr in ipairs(getAllPlayers()) do
        local row = newRow(assignScroll, i)
        newLabel(row, plr.Name, UDim2.new(1,-220,1,0), UDim2.new(0,10,0,0),
            Color3.fromRGB(255,255,255), Enum.Font.GothamBold, 13, 25)
        local uid = plr.UserId
        for k, key in ipairs(TIRE_ORDER) do
            local info = TIRES[key]
            local dark = (key ~= "soft")
            local b = newButton(row, info.name, UDim2.new(0,66,0,28),
                UDim2.new(1, -(4 - k) * 70 - 4, 0.5, -14),
                info.color, dark and Color3.fromRGB(20,20,20) or Color3.fromRGB(255,255,255), 11, 26)
