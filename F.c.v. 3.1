local moveStep = 4
local scaleStep = 1
local rotStep = 15

local function getActiveBox()
    if selectedObject == "meta"    then return metaBox
    elseif selectedObject == "qualy"   then return qualyBox
    elseif selectedObject == "fastlap" then return fastLapBox
    elseif selectedObject == "cc"      then return ccPendingBox
    elseif selectedObject == "sector_cyan"   then return sectorBoxCyan
    elseif selectedObject == "sector_yellow" then return sectorBoxYellow
    elseif selectedObject == "sector_red"    then return sectorBoxRed
    end
    return nil
end

btnFwd.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(0,0,-moveStep) end
end)
btnBack.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(0,0,moveStep) end
end)
btnLeft.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(-moveStep,0,0) end
end)
btnRight.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(moveStep,0,0) end
end)
btnUp.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(0,moveStep,0) end
end)
btnDown.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.new(0,-moveStep,0) end
end)
btnScaleUp.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.Size = b.Size + Vector3.new(scaleStep,scaleStep,scaleStep) end
end)
btnScaleDown.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then
        local ns = b.Size - Vector3.new(scaleStep,scaleStep,scaleStep)
        if ns.X > 2 then b.Size = ns end
    end
end)
btnRotate.MouseButton1Click:Connect(function()
    local b = getActiveBox()
    if b then b.CFrame = b.CFrame * CFrame.Angles(0, math.rad(rotStep), 0) end
end)

btnFix.MouseButton1Click:Connect(function()
    BoxControls.Visible = false
    F1MButton.Visible   = true
    CCButton.Visible    = true

    if selectedObject == "cc" then
        -- Al fijar un cuadro CC, no reanudamos la carrera: pedimos nombre
        selectedObject = nil
        openCCNamePrompt()
        return
    end

    local wasMeta = (selectedObject == "meta")
    selectedObject = nil
    if wasMeta and metaBox and not raceActive then
        raceActive    = true
        F1Bar.Visible = true
        for _, plr in ipairs(getAllPlayers()) do
            playerLaps[plr.UserId]   = 0
            playerLapTimestamp[plr.UserId] = nil
            playerLastLapCross[plr.UserId] = nil
            playerLastMetaCrossTick[plr.UserId] = nil
            playerStatus[plr.UserId] = "outlap"
        end
        resetGapTracker(metaGapTracker)
        resetGapTracker(sectorGapTrackers.cyan)
        resetGapTracker(sectorGapTrackers.yellow)
        resetGapTracker(sectorGapTrackers.red)
        sectorPassCount   = { cyan = {}, yellow = {}, red = {} }
        sectorInsideState = { cyan = {}, yellow = {}, red = {} }
        updateF1Bar()
    end
end)

createTrackBox = function(color)
    local box = Instance.new("Part")
    box.Anchored     = true
    box.CanCollide   = false
    box.Transparency = 0.4
    box.Material     = Enum.Material.Neon
    box.BrickColor   = BrickColor.new(color)
    box.Size         = Vector3.new(16,2,2)
    local p = getCharacterPosition(LocalPlayer)
    box.CFrame       = p and CFrame.new(p + Vector3.new(0,1,0)) or CFrame.new(0,5,0)
    box.Parent       = workspace

    local sel = Instance.new("SelectionBox")
    sel.Adornee      = box
    sel.Color3       = color=="Bright green"  and Color3.fromRGB(0,255,0)
                    or color=="Bright orange" and Color3.fromRGB(255,140,0)
                    or color=="White"         and Color3.fromRGB(255,255,255)
                    or color=="Cyan"          and Color3.fromRGB(0,230,230)
                    or color=="Bright yellow" and Color3.fromRGB(255,220,0)
                    or color=="Really red"    and Color3.fromRGB(255,30,30)
                    or Color3.fromRGB(0,120,255)
    sel.LineThickness = 0.06
    sel.Parent        = workspace
    return box, sel
end

