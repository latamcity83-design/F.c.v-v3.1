-- ============================================================
-- SISTEMA DE GAP (estilo F1)
-- Cuando el piloto que va MAS ADELANTE (mayor conteo: vueltas o
-- pasadas por un sector) hace su cruce, se marca como "lider" de ese
-- cruce y arranca un cronometro. Los demas pilotos quedan en estado
-- "pending" (su gap se ve corriendo en vivo, actualizado por
-- segundo) hasta que ELLOS TAMBIEN crucen: ahi su gap se congela
-- (el tiempo que tardaron en alcanzar ese cruce desde que el lider
-- lo hizo). El mismo sistema sirve para la meta y para cada sector.
-- ============================================================
local function makeGapTracker()
    return {
        leaderTick = nil,
        state = {}, -- [uid] = "leader" | "pending" | "locked"
        value = {}, -- [uid] = segundos (congelado)
    }
end

local function gapOnCross(tracker, crossedUid, getCount)
    local newCount = getCount(crossedUid)
    local isNewLeader = true
    for _, otherPlr in ipairs(getAllPlayers()) do
        if otherPlr.UserId ~= crossedUid then
            local otherCount = getCount(otherPlr.UserId)
            if otherCount >= newCount then
                isNewLeader = false
                break
            end
        end
    end

    if isNewLeader then
        tracker.leaderTick = tick()
        for _, plr in ipairs(getAllPlayers()) do
            if plr.UserId == crossedUid then
                tracker.state[plr.UserId] = "leader"
                tracker.value[plr.UserId] = nil
            else
                tracker.state[plr.UserId] = "pending"
                tracker.value[plr.UserId] = nil
            end
        end
    else
        if tracker.leaderTick then
            tracker.value[crossedUid] = tick() - tracker.leaderTick
        end
        tracker.state[crossedUid] = "locked"
    end
end

local function resetGapTracker(tracker)
    tracker.leaderTick = nil
    tracker.state = {}
    tracker.value = {}
end

local function formatGap(tracker, uid)
    local state = tracker.state[uid]
    if state == "leader" then
        return "GAP", Color3.fromRGB(255,220,50)
    elseif state == "pending" and tracker.leaderTick then
        local live = tick() - tracker.leaderTick
        return "+" .. string.format("%.1f", live), Color3.fromRGB(255,140,60)
    elseif state == "locked" and tracker.value[uid] then
        return "+" .. string.format("%.3f", tracker.value[uid]), Color3.fromRGB(150,255,150)
    end
    return "--", Color3.fromRGB(120,120,130)
end

