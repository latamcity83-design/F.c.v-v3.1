-- ============================================================
-- DETECCION META + FAST LAP
-- ============================================================
local playerInMeta = {}

RunService.Heartbeat:Connect(function()
    if replayPlaying then return end
    for _, plr in ipairs(getAllPlayers()) do
        local uid  = plr.UserId
        local char = plr.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos = hrp.Position
                local hum = char:FindFirstChildOfClass("Humanoid")
                local inVehicle = isInVehicleSeat(hum)

                -- META
                if metaBox and raceActive and inVehicle and not redFlagActive then
                    local inside = isInsideBox(pos, metaBox)
                    if inside and not playerInMeta[uid] then
                        playerInMeta[uid] = true

                        local prevLaps = playerLaps[uid] or 0
                        local alreadyFinished = totalLaps > 0 and prevLaps >= totalLaps
                        local lastCross = playerLastLapCross[uid] or 0
                        local tooSoon = (tick() - lastCross) < 10

                        -- Si ya termino la carrera (llego a las vueltas
                        -- establecidas en Race) o si paso de nuevo por la
                        -- meta muy rapido (menos de 10s, probablemente por
                        -- error), no se cuenta esta vuelta.
                        if not alreadyFinished and not tooSoon then
                            playerLastLapCross[uid] = tick()

                            -- FAST LAP: tiempo de ESTA vuelta (desde el
                            -- cruce valido anterior de este mismo piloto)
                            local nowTick = tick()
                            local prevCrossTick = playerLastMetaCrossTick[uid]
                            if prevCrossTick then
                                local lapDuration = nowTick - prevCrossTick
                                local prevBest = fastLapTimes[uid]
                                if not prevBest or lapDuration < prevBest then
                                    fastLapTimes[uid] = lapDuration
                                end
                                if not fastLapOverallBest or lapDuration < fastLapOverallBest.time then
                                    fastLapOverallBest = { uid = uid, name = plr.Name, time = lapDuration }
                                end
                                if updateFastLapPanel then updateFastLapPanel() end
                            end
                            playerLastMetaCrossTick[uid] = nowTick

                            playerLaps[uid]   = prevLaps + 1
                            playerLapTimestamp[uid] = tick()
                            playerStatus[uid] = "lap"
                            -- Registrar inicio de sesion en el primer paso
                            if not raceStartTime then
                                raceStartTime = tick()
                                logEvent("Sesion iniciada")
                            end
                            -- Registrar vuelta completada con tiempo si lo hay
                            local lapNum = playerLaps[uid]
                            local plrName = plr.Name
                            if playerLapTimes[uid] then
                                logEvent("VUELTA " .. lapNum .. ": " .. plrName .. " - mejor qualy " .. formatTime(playerLapTimes[uid]))
                            else
                                logEvent("VUELTA " .. lapNum .. ": " .. plrName)
                            end
                            reorderByLaps()
                            gapOnCross(metaGapTracker, uid, function(u) return playerLaps[u] or 0 end)
                            updateF1Bar()
                        end
                    elseif not inside then
                        playerInMeta[uid] = false
                    end
                elseif metaBox and inVehicle then
                    -- Con red flag activa: seguimos detectando el paso por
                    -- la meta (para no generar un conteo falso al
                    -- desactivar la bandera) pero SIN sumar vuelta.
                    local inside = isInsideBox(pos, metaBox)
                    if not inside then
                        playerInMeta[uid] = false
                    end
                end

                -- QUALY (antes "FAST LAPS"): solo cronometra mientras
                -- la sesion de Qualy este activa (dentro del tiempo
                -- que se establecio en el cronometro de arriba)
                if fastLapBox and inVehicle and qualyActive then
                    local inside = isInsideBox(pos, fastLapBox)
                    local state  = playerFLState[uid] or "outside"

                    if inside and state == "outside" then
                        playerFLState[uid] = "inside"
                        if playerInTiming[uid] == nil then
                            playerInTiming[uid] = tick()
                        else
                            local elapsed = tick() - playerInTiming[uid]
                            -- Ignorar tiempos menores de 10 segundos (invalidos)
                            if elapsed >= 10 then
                                local best = playerLapTimes[uid]
                                if not best or elapsed < best then
                                    playerLapTimes[uid] = elapsed
                                    updateFastLapsPanel()
                                    local timeStr = formatTime(elapsed)
                                    local isNew = not best
                                    if isNew then
                                        sendDiscordEvent(":stopwatch: **" .. plr.Name .. "** ha hecho **" .. timeStr .. "** en Qualy")
                                        logEvent("QUALY: " .. plr.Name .. " - " .. timeStr)
                                    else
                                        sendDiscordEvent(":zap: **" .. plr.Name .. "** mejoro su tiempo a **" .. timeStr .. "** (antes " .. formatTime(best) .. ")")
                                        logEvent("MEJOR TIEMPO: " .. plr.Name .. " - " .. timeStr)
                                    end
                                else
                                    -- Tiempo hecho pero no mejora el personal
                                    sendDiscordEvent(":stopwatch: **" .. plr.Name .. "** hizo **" .. formatTime(elapsed) .. "** (sin mejorar personal: " .. formatTime(best) .. ")")
                                end
                            end
                            playerInTiming[uid] = tick()
                        end
                    elseif not inside and state == "inside" then
                        playerFLState[uid] = "outside"
                    end
                end
            end
        end
    end
end)

-- ============================================================
-- DETECCION DE PASO POR SECTORES (estilo F1)
-- Cada sector (cian/amarillo/rojo) funciona igual que la meta para
-- efectos de GAP: el primero en pasar por ESE sector queda como
-- referencia y arranca el cronometro; los demas se congelan al pasar.
-- ============================================================
RunService.Heartbeat:Connect(function()
    if replayPlaying then return end
    if not (sectorBoxCyan or sectorBoxYellow or sectorBoxRed) then return end

    local sectorDefs = {
        { color = "cyan",   box = sectorBoxCyan   },
        { color = "yellow", box = sectorBoxYellow },
        { color = "red",    box = sectorBoxRed    },
    }

    for _, plr in ipairs(getAllPlayers()) do
        local char = plr.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hrp and isInVehicleSeat(hum) then
                for _, def in ipairs(sectorDefs) do
                    if def.box then
                        local uid   = plr.UserId
                        local inside = isInsideBox(hrp.Position, def.box)
                        local state  = sectorInsideState[def.color][uid] or "outside"
                        if inside and state == "outside" then
                            sectorInsideState[def.color][uid] = "inside"
                            sectorPassCount[def.color][uid] = (sectorPassCount[def.color][uid] or 0) + 1
                            gapOnCross(sectorGapTrackers[def.color], uid, function(u)
                                return sectorPassCount[def.color][u] or 0
                            end)
                            if updateSectorListPanel then updateSectorListPanel() end
                        elseif not inside and state == "inside" then
                            sectorInsideState[def.color][uid] = "outside"
                        end
                    end
                end
            end
        end
    end
end)


