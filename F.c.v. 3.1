-- ---------- monoplaza F1 (miniatura) ----------
local TEAM_COLORS = {
    Color3.fromRGB(225,25,25),  Color3.fromRGB(30,100,230), Color3.fromRGB(255,140,0),
    Color3.fromRGB(0,190,150),  Color3.fromRGB(160,60,220), Color3.fromRGB(240,220,30),
    Color3.fromRGB(255,110,180),Color3.fromRGB(90,200,40),  Color3.fromRGB(0,200,230),
    Color3.fromRGB(235,235,235),
}
local BASE_LEN = 8.5 -- largo del monoplaza en studs a escala 1

local function buildF1Marker(color, userName)
    local model = Instance.new("Model")
    model.Name = "F1Marker"
    local dark = Color3.fromRGB(20,20,24)
    local function part(name, size, pos, col)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.CFrame = CFrame.new(pos)
        p.Color = col
        p.Material = Enum.Material.SmoothPlastic
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Parent = model
        return p
    end
    local body = part("Body", Vector3.new(1.0,0.6,5.0), Vector3.new(0,0.3,0), color)
    part("Nose",     Vector3.new(0.6,0.4,2.2), Vector3.new(0,0.25,-3.4), color)
    part("Sidepods", Vector3.new(2.0,0.45,2.2), Vector3.new(0,0.3,0.8), color)
    part("Cockpit",  Vector3.new(0.8,0.5,1.0), Vector3.new(0,0.8,0.2), dark)
    part("FrontWing",Vector3.new(3.6,0.15,0.7), Vector3.new(0,0.1,-4.3), dark)
    part("RearWing", Vector3.new(2.6,0.9,0.35), Vector3.new(0,0.85,2.9), dark)
    part("WheelFL",  Vector3.new(0.7,0.8,1.2), Vector3.new(-1.5,0.4,-2.6), dark)
    part("WheelFR",  Vector3.new(0.7,0.8,1.2), Vector3.new(1.5,0.4,-2.6), dark)
    part("WheelRL",  Vector3.new(0.8,0.9,1.4), Vector3.new(-1.6,0.45,2.2), dark)
    part("WheelRR",  Vector3.new(0.8,0.9,1.4), Vector3.new(1.6,0.45,2.2), dark)
    model.PrimaryPart = body

    -- nombre de usuario encima del monoplaza
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,160,0,76)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = body
    bb.Parent = body
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,0,20)
    lbl.Position = UDim2.new(0,0,0,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = userName
    lbl.TextColor3 = Color3.fromRGB(255,255,255)
    lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = 14
    lbl.Parent = bb
    return model
end

-- ---------- estado del mapa ----------
local mapActive     = false
local mapMode       = nil     -- "track" | "player"
local followUid     = nil
local camH          = 2600
local mapCenter     = Vector3.new(0,0,0)
local markers       = {}      -- [uid] = { model=, last=Vector3, heading=Vector3, scale=number }
local markerFolder  = nil
local stepConn      = nil
local dragging      = false
local savedFog      = nil
local savedAtmos    = {}
local savedCamType  = nil

local function clampH()
    if mapMode == "track" then camH = math.clamp(camH, 150, 9000)
    else camH = math.clamp(camH, 50, 1200) end
end

local function removeMarker(uid)
    local m = markers[uid]
    if m then
        if m.model then m.model:Destroy() end
        markers[uid] = nil
    end
end

local function stopMap()
    if not mapActive then return end
    mapActive = false
    if stepConn then stepConn:Disconnect(); stepConn = nil end
    for uid, _ in pairs(markers) do removeMarker(uid) end
    if markerFolder then markerFolder:Destroy(); markerFolder = nil end
    dragCapture.Visible = false
    mapExitBtn.Visible = false
    zoomInBtn.Visible  = false
    zoomOutBtn.Visible = false
    mapTitle.Visible   = false
    pcall(function()
        if savedFog then Lighting.FogEnd = savedFog end
        for atm, vals in pairs(savedAtmos) do
            if atm.Parent then atm.Density = vals.d; atm.Haze = vals.h end
        end
    end)
    savedAtmos = {}
    pcall(function()
        local cam = workspace.CurrentCamera
        cam.CameraType = savedCamType or Enum.CameraType.Custom
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end)
    F1MButton.Visible = true
    CCButton.Visible  = true
    Dashboard.Visible = true
end

local function flatHeading(from, to)
    local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
    if d.Magnitude > 0.12 then return d.Unit end
    return nil
end

local function mapStep()
    local cam = workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Scriptable

    local k = math.max(1.2, (camH * 0.055) / BASE_LEN)
    local yOff = math.clamp(camH * 0.02, 8, 80)

    local seen = {}
    local followPos = nil
    for _, plr in ipairs(getAllPlayers()) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local uid = plr.UserId
            seen[uid] = true
            local m = markers[uid]
            if not m then
                local model = buildF1Marker(TEAM_COLORS[(uid % #TEAM_COLORS) + 1], plr.Name)
                model.Parent = markerFolder
                m = { model = model, last = hrp.Position, heading = Vector3.new(0,0,-1), scale = 1 }
                markers[uid] = m
            end
            local pos = hrp.Position
            local h = flatHeading(m.last, pos)
            if h then m.heading = m.heading:Lerp(h, 0.25) end
            if m.heading.Magnitude < 0.01 then m.heading = Vector3.new(0,0,-1) end
            m.last = pos
            if math.abs(k - m.scale) / m.scale > 0.04 then
                pcall(function() m.model:ScaleTo(k) end)
                m.scale = k
            end
            local at = Vector3.new(pos.X, pos.Y + yOff, pos.Z)
            pcall(function() m.model:PivotTo(CFrame.lookAt(at, at + m.heading)) end)
            if mapMode == "player" and uid == followUid then followPos = pos end
        end
    end
    for uid, _ in pairs(markers) do
        if not seen[uid] then removeMarker(uid) end
    end

    if mapMode == "player" then
        if followPos then
            mapCenter = mapCenter:Lerp(followPos, 0.2)
        elseif not Players:GetPlayerByUserId(followUid) then
            stopMap()
            return
        end
    end

    local camPos = mapCenter + Vector3.new(0, camH, 0)
    cam.FieldOfView = 70
    cam.CFrame = CFrame.lookAt(camPos, mapCenter, Vector3.new(0,0,-1))
end

local function startMap(mode, uid)
    if replayPlaying then return end
    if onboardActive then
        showAlertText("Desactiva la camara Onboard primero", Color3.fromRGB(230,140,20))
        return
    end
    if mapActive then stopMap() end
    mapActive = true
    mapMode   = mode
    followUid = uid
    camH      = (mode == "track") and 2600 or 220

    -- centro inicial
    local center
    if mode == "player" then
        local plr = Players:GetPlayerByUserId(uid)
        local hrp = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        center = hrp and hrp.Position
    else
        local sum, n = Vector3.new(0,0,0), 0
        for _, plr in ipairs(getAllPlayers()) do
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then sum = sum + hrp.Position; n = n + 1 end
        end
        if n > 0 then center = sum / n end
    end
    mapCenter = center or Vector3.new(0,0,0)

    Dashboard.Visible = false
    F1MButton.Visible = false
    CCButton.Visible  = false

    markerFolder = Instance.new("Folder")
    markerFolder.Name = "F1MTelemetry"
    markerFolder.Parent = workspace

    -- sin niebla para ver el mapa desde lejos
    pcall(function()
        savedFog = Lighting.FogEnd
        Lighting.FogEnd = 1e6
        for _, ch in ipairs(Lighting:GetChildren()) do
            if ch:IsA("Atmosphere") then
                savedAtmos[ch] = { d = ch.Density, h = ch.Haze }
                ch.Density = 0
                ch.Haze = 0
            end
        end
    end)
    pcall(function() savedCamType = workspace.CurrentCamera.CameraType end)

    local title = "TELEMETRY MAP  |  PISTA"
    if mode == "player" then
        local plr = Players:GetPlayerByUserId(uid)
        title = "TELEMETRY MAP  |  " .. (plr and plr.Name or "?")
    end
    mapTitle.Text = title
    dragCapture.Visible = true
    mapExitBtn.Visible  = true
    zoomInBtn.Visible   = true
    zoomOutBtn.Visible  = true
    mapTitle.Visible    = true

    stepConn = RunService.RenderStepped:Connect(mapStep)
end

-- ---------- controles ----------
mapExitBtn.MouseButton1Click:Connect(stopMap)
zoomInBtn.MouseButton1Click:Connect(function()  camH = camH * 0.78; clampH() end)
zoomOutBtn.MouseButton1Click:Connect(function() camH = camH * 1.28; clampH() end)

dragCapture.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
    end
end)
dragCapture.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
dragCapture.InputChanged:Connect(function(input)
    if not mapActive then return end
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        local z = input.Position.Z
        if z > 0 then camH = camH * 0.85 else camH = camH * 1.18 end
        clampH()
    elseif dragging and mapMode == "track"
        and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local cam = workspace.CurrentCamera
        local vp = cam.ViewportSize
        local sPerPx = 2 * camH * math.tan(math.rad(cam.FieldOfView / 2)) / math.max(vp.Y, 1)
        local d = input.Delta
        mapCenter = mapCenter + Vector3.new(-d.X * sPerPx, 0, -d.Y * sPerPx)
    end
end)

specBtn.MouseButton1Click:Connect(function() startMap("track") end)
ScreenGui.Destroying:Connect(stopMap)

