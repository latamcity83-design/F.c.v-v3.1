        for i, entry in ipairs(sorted) do
            local plr = Players:GetPlayerByUserId(entry.uid)
            local displayName = plr and plr.Name or ("UserId " .. entry.uid)

            local row = Instance.new("Frame")
            row.Size             = UDim2.new(1,-10,0,28)
            row.BackgroundColor3 = (i%2==0) and Color3.fromRGB(20,20,32) or Color3.fromRGB(26,26,40)
